APP_NAME="Hoy Malika Data Studio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dataset.example.com
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=en
LOG_CHANNEL=daily
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hoy_malika
DB_USERNAME=hoy_malika
DB_PASSWORD=
QUEUE_CONNECTION=redis
DB_QUEUE_RETRY_AFTER=420
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Exact proxy IP/CIDR only; never use * on a publicly reachable service.
TRUSTED_PROXIES=
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_POLLING_RETRY_SECONDS=3
TARGET_RECORDINGS_PER_USER=20
MIN_PARTICIPANT_AGE=18
VOICE_MIN_DURATION_SECONDS=0.5
VOICE_MAX_DURATION_SECONDS=6
VOICE_MAX_BYTES=20971520
ACCEPT_AUDIO_MESSAGES=false
DATASET_DISK=local
DATASET_HOST_PATH=./docker-data/dataset
MINIMUM_FREE_DISK_BYTES=1073741824
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
LOCAL_SYNC_ENABLED=true
# Generate with: openssl rand -hex 32  (must be >= 32 chars; the same value goes in the local agent as API_TOKEN)
LOCAL_SYNC_API_TOKEN=
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
VITE_APP_NAME="${APP_NAME}"

APP_PORT=8080

# Parallel queue workers (docker compose replicas). Different participants are processed in parallel;
# one participant's messages always stay in order.
QUEUE_WORKERS=10
REPLY_WORKERS=4
DRIVE_WORKERS=3
